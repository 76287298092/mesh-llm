From a159e19fab41d9ad86ede31f8d6973eaabf3ac7b Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Fri, 2 Oct 2026 23:44:21 +0800
Subject: port: DeepSeek-V4.1 (deepseek41) + Skippy geometry annotations +
 on-demand mmap load

- port upstream llama.cpp PR #28696 (deepseek41) onto the Mesh v0.77.0 Skippy baseline
- keep Skuppy graph-semantics annotations on the V4.1 graph (23 sites, matching V4)
- export dsv4_note_tokens/dsv4_note_source_dimension so the V4.1 builder can annotate
- MESH_LLAMA_MMAP_PREFETCH=0 maps the model without faulting it in, so a model far
  larger than RAM loads in seconds and pages come in on demand
---
 src/llama-model.cpp       | 15 ++++++++++++++-
 src/models/deepseek4.cpp  |  6 +++---
 src/models/deepseek41.cpp | 26 +++++++++++++++++++++++++-
 src/models/models.h       | 11 +++++++++++
 4 files changed, 53 insertions(+), 5 deletions(-)

diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index 42b7b93..ce7c7a9 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -1792,7 +1792,20 @@ bool llama_model_base::load_tensors(llama_model_loader & ml) {
         }
     }
 
-    ml.init_mappings(true, use_mlock ? &pimpl->mlock_mmaps : nullptr);
+    // Prefetching faults the whole file in up front (PrefetchVirtualMemory on Windows,
+    // MAP_POPULATE elsewhere). A model that does not fit in RAM must not do that: map it and let
+    // the pages come in on demand instead. Lazy tensors are already excluded from the prefetch
+    // range, so this switch only widens that same treatment to the rest of the file.
+    //   MESH_LLAMA_MMAP_PREFETCH=0  -> map only, read on demand (default: prefetch)
+    static const bool mesh_mmap_prefetch = []() {
+        const char * value = getenv("MESH_LLAMA_MMAP_PREFETCH");
+        return value == nullptr || (value[0] != '0' && value[0] != '\0');
+    }();
+    if (!mesh_mmap_prefetch) {
+        LLAMA_LOG_WARN("%s: mmap prefetch disabled; model pages are read on demand\n", __func__);
+    }
+
+    ml.init_mappings(mesh_mmap_prefetch, use_mlock ? &pimpl->mlock_mmaps : nullptr);
     pimpl->mappings.reserve(ml.mappings.size());
 
     // create the backend buffers
diff --git a/src/models/deepseek4.cpp b/src/models/deepseek4.cpp
index 91b572e..46b51b9 100644
--- a/src/models/deepseek4.cpp
+++ b/src/models/deepseek4.cpp
@@ -213,18 +213,18 @@ ggml_tensor * dsv4_view_2d(
     return result;
 }
 
-static void dsv4_note_tokens(ggml_tensor * tensor, int32_t axis) {
+void dsv4_note_tokens(ggml_tensor * tensor, int32_t axis) {
     auto geometry = skippy_stage_geometry_static(tensor);
     geometry.dimensions[axis] = skippy_stage_geometry_expression::tokens();
     skippy_stage_geometry_note(tensor, geometry);
 }
 
-static void dsv4_note_source_dimension(
+void dsv4_note_source_dimension(
         ggml_tensor * tensor,
         int32_t target_axis,
         int32_t source,
         int32_t source_axis,
-        int64_t divisor = 1) {
+        int64_t divisor) {
     auto geometry = skippy_stage_geometry_static(tensor);
     geometry.dimensions[target_axis] =
             skippy_stage_geometry_expression::source_dimension(source, source_axis, 1, divisor);
