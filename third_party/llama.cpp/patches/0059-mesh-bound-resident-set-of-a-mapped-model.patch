From 9e1a5361c5df07baf6e7d809f29aff4f768f59c9 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Fri, 2 Oct 2026 23:51:14 +0800
Subject: mesh: bound the resident set of a mapped model that is far larger
 than RAM

Decoding touches weights in every layer, so a mapped model whose size exceeds RAM grows its
resident set with each token, and Windows offers no user-space way to evict a mapped page.
MESH_LLAMA_WS_BUDGET_MB sets a resident-set trigger; once it is passed, graph_compute asks the
OS to trim the working set back to the mapping. Pages stay file-backed and fault back in on
demand, so the growth becomes a plateau instead of an unbounded climb.

Measured on DeepSeek-V4.1-Flash-Q2_K (264 GB) with MESH_LLAMA_MMAP_PREFETCH=0: before, the
watchdog killed at 7.1-7.7 GiB after one token; after, six tokens complete with a 5.7 GiB peak
and a stable ~5.8 GiB working set.
---
 src/llama-context.cpp |  5 +++++
 src/llama-mmap.cpp    | 49 +++++++++++++++++++++++++++++++++++++++++++
 src/llama-mmap.h      |  3 +++
 3 files changed, 57 insertions(+)

diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index e522c84..e2213e5 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -3134,6 +3134,11 @@ ggml_status llama_context::graph_compute(
         set_n_threads_fn.second(set_n_threads_fn.first, n_threads);
     }
 
+    // The compute below is asynchronous, so the pages a graph faults in are not resident yet when
+    // it returns. Check before it runs: by then the previous graph has completed and its resident
+    // set is real, which is the number a budget is meant to bound.
+    llama_residency_trim_if_over_budget();
+
     auto status = ggml_backend_sched_graph_compute_async(sched.get(), gf);
     if (status != GGML_STATUS_SUCCESS) {
         LLAMA_LOG_ERROR("%s: ggml_backend_sched_graph_compute_async failed with error %d\n", __func__, status);
diff --git a/src/llama-mmap.cpp b/src/llama-mmap.cpp
index 1f6b2c5..4774370 100644
--- a/src/llama-mmap.cpp
+++ b/src/llama-mmap.cpp
@@ -35,6 +35,7 @@
         #define PATH_MAX MAX_PATH
     #endif
     #include <io.h>
+    #include <psapi.h>
 #endif
 
 #if defined(__APPLE__)
@@ -864,3 +865,51 @@ const bool llama_mlock::SUPPORTED = false;
 size_t llama_path_max() {
     return PATH_MAX;
 }
+
+// Bound the resident set of a model that is mapped but far larger than RAM. Decoding touches
+// weights in every layer, so the resident set grows with each token, and Windows offers no
+// user-space way to evict a mapped page. Once the resident set passes the budget, ask the OS to
+// trim it: the pages stay backed by the file mapping and fault back in on demand.
+//   MESH_LLAMA_WS_BUDGET_MB=6000   -> trim whenever the resident set passes 6 GiB
+bool llama_residency_trim_if_over_budget() {
+    static const size_t budget_bytes = []() -> size_t {
+        const char * value = getenv("MESH_LLAMA_WS_BUDGET_MB");
+        if (value == nullptr) {
+            return 0;
+        }
+        const long long mb = atoll(value);
+        return mb > 0 ? (size_t) mb * 1024u * 1024u : 0;
+    }();
+
+    if (budget_bytes == 0) {
+        return false;
+    }
+
+#ifdef _WIN32
+    PROCESS_MEMORY_COUNTERS counters = {};
+    if (!GetProcessMemoryInfo(GetCurrentProcess(), &counters, sizeof(counters))) {
+        return false;
+    }
+    LLAMA_LOG_WARN("%s: budget = %zu MiB, working set = %zu MiB\n", __func__,
+            budget_bytes / (1024u * 1024u), (size_t) counters.WorkingSetSize / (1024u * 1024u));
+    if (counters.WorkingSetSize <= budget_bytes) {
+        return false;
+    }
+    if (!SetProcessWorkingSetSize(GetCurrentProcess(), (SIZE_T) -1, (SIZE_T) -1)) {
+        LLAMA_LOG_WARN("%s: SetProcessWorkingSetSize failed: %s\n", __func__,
+                llama_format_win_err(GetLastError()).c_str());
+        return false;
+    }
+#else
+    // POSIX could drop clean file-backed pages here, but the staging path does not use it yet.
+    return false;
+#endif
+
+    static bool logged = false;
+    if (!logged) {
+        logged = true;
+        LLAMA_LOG_WARN("%s: resident set passed %zu MiB, trimming to the model mapping\n",
+                __func__, budget_bytes / (1024u * 1024u));
+    }
+    return true;
+}
diff --git a/src/llama-mmap.h b/src/llama-mmap.h
index 625fda8..6a71776 100644
--- a/src/llama-mmap.h
+++ b/src/llama-mmap.h
@@ -87,3 +87,6 @@ private:
 };
 
 size_t llama_path_max();
+
+// Bound the resident set of a model that is mapped but far larger than RAM. See llama-mmap.cpp.
+bool llama_residency_trim_if_over_budget();
